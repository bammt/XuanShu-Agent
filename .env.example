ADMIN_PASSWORD=change-me-now
BACKEND_PORT=18112
FRONTEND_PORT=8012
MAX_UPLOAD_MB=50
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXECUTOR_URL=http://executor:8020
CODE_TIMEOUT_SECONDS=60
RUN_MAX_RETRIES=3
RUN_RETRY_BASE_SECONDS=1.5
CONVERSATION_RETENTION_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=720
EXECUTOR_SHARED_SECRET=replace-with-a-long-random-secret
EXECUTOR_MAX_SNAPSHOT_MB=50
