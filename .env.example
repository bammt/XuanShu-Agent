KNOWLEDGE_WORKER_CONCURRENCY=2
STUDIO_WORKER_CONCURRENCY=4
STUDIO_SESSION_LOCK_SECONDS=3600
EXTERNAL_SESSION_RETENTION_DAYS=30
EXTERNAL_UPLOAD_RETENTION_DAYS=30
CREWAI_TRACING_ENABLED=false
